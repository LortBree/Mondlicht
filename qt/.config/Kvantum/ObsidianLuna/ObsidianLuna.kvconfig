[%General]
author=Mondlicht
comment=Obsidian Luna dark theme for Qt5/Qt6 & Dolphin
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=4
toolbar_interior_spacing=4
spread_progressbar=true
composite=true
menu_shadow_depth=6
menu_blur_radius=0
tooltip_shadow_depth=4
splitter_width=4
scroll_width=8
scroll_min_extent=32
scroll_arrows=false
tree_branch_line=true
slider_width=4
slider_handle_width=14
slider_handle_length=14
tickless_slider_handle_size=14
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=16
fill_rubberband=true
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=18
combo_as_lineedit=true
animate_states=true
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=true
transient_scrollbar=false
scrollable_menu=true
scrollbar_in_view=true
reduce_window_opacity=0
reduce_menu_opacity=0
respect_DE=true
click_behavior=0
inline_spin_indicators=true
layout_spacing=4
layout_margin=6
no_window_pattern=true
no_inactiveness=false

[GeneralColors]
window.color=#0b0d15
base.color=#08090e
alt.base.color=#0e111b
button.color=#141826
light.color=#1f2538
mid.light.color=#171c2b
dark.color=#05060a
mid.color=#10131e
highlight.color=#273b7a
inactive.highlight.color=#1a2447
text.color=#dce4f7
window.text.color=#dce4f7
button.text.color=#dce4f7
disabled.text.color=#68728c
tooltip.text.color=#dce4f7
highlight.text.color=#dce4f7
link.color=#adc6ff
link.visited.color=#debcdf
progress.indicator.text.color=#08090e

[Hacks]
transparent_dolphin_view=false
transparent_ktitle_label=true
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
tint_on_mouseover=12
no_selection_tint=false
disabled_icon_opacity=55
normal_default_pushbutton=true
single_top_toolbar=true
middle_click_scroll=false

[Panel]
inherits=PanelButtonCommand
frame=true
frame.element=panel
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=panel
text.normal.color=#dce4f7

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=8
text.normal.color=#dce4f7
text.focus.color=#dce4f7
text.press.color=#dce4f7
text.toggle.color=#adc6ff
text.margin.top=4
text.margin.bottom=4
text.margin.left=10
text.margin.right=10
min_width=+0.4font
min_height=+0.3font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=toolbutton
interior.element=toolbutton
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6

[ToolbarButton]
inherits=PanelButtonTool

[ItemView]
inherits=PanelButtonCommand
frame=true
frame.element=itemview
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=itemview
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.normal.color=#dce4f7
text.focus.color=#dce4f7
text.press.color=#dce4f7
text.toggle.color=#dce4f7

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[ComboBox]
inherits=LineEdit

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
frame.top=4
frame.bottom=4
frame.left=6
frame.right=6
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
text.toggle.color=#adc6ff

[TabBar]
inherits=Panel
frame=false
interior=false

[Menu]
inherits=Panel
frame.element=menu
interior.element=menu
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.left=6
text.margin.right=6

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.margin.top=3
text.margin.bottom=3
text.margin.left=8
text.margin.right=8
text.focus.color=#dce4f7

[ToolTip]
inherits=Panel
frame.element=tooltip
interior.element=tooltip
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[Scrollbar]
indicator.size=8
text.normal.color=#dce4f7

[ScrollbarSlider]
frame=true
frame.element=scrollbarslider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=scrollbarslider

[Progressbar]
frame=true
frame.element=progressbar
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=progressbar

[ProgressbarContents]
frame=false
interior=true
interior.element=progresscontents

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6

[CheckBox]
indicator.element=checkbox
indicator.size=16
text.margin.left=6

[RadioButton]
indicator.element=radiobutton
indicator.size=16
text.margin.left=6
