{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": {
      "1": "bright_blue",
      "2": "white"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "bright_blue",
      "title": "white"
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "OS     "
    },
    {
      "type": "kernel",
      "key": "Kernel "
    },
    {
      "type": "wm",
      "key": "WM     "
    },
    {
      "type": "shell",
      "key": "Shell  "
    },
    {
      "type": "terminal",
      "key": "Term   "
    },
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "cpu",
      "key": "CPU    "
    },
    {
      "type": "gpu",
      "key": "GPU    "
    },
    {
      "type": "memory",
      "key": "Memory "
    },
    {
      "type": "packages",
      "key": "Pkgs   "
    },
    {
      "type": "uptime",
      "key": "Uptime "
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
