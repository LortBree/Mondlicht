[Unit]
Description=Mondlicht Removable Media Automounter (udiskie)
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/usr/bin/udiskie

[Service]
Type=simple
ExecStart=/usr/bin/udiskie --automount --notify --no-tray
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
