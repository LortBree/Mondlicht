import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Bluetooth
import Quickshell.Services.Pipewire
import Quickshell.Services.UPower


FloatingWindow {
    id: win
    required property var shell
    title: "Mondlicht Settings"
    implicitWidth: 840
    implicitHeight: 560
    minimumSize: Qt.size(740, 480)
    color: "transparent"
    visible: true

    onClosed: win.shell.settingsOpen = false

    // Palette synced directly from shared Theme singleton
    readonly property color colVoid: Theme.voidBg
    readonly property color colSidebar: Theme.backdropBg
    readonly property color colCard: Theme.glassBg
    readonly property color colElevated: Theme.elevatedBg
    readonly property color colRim: Theme.rim
    readonly property color colText: Theme.text
    readonly property color colMuted: Theme.muted
    readonly property color colOk: Theme.ok
    readonly property color colWarn: Theme.warn
    readonly property color colAccent: Theme.accent
    readonly property color colSecondary: Theme.secondary
    readonly property color colAccentFg: Theme.accentFg
    readonly property color colCrit: Theme.crit
    readonly property string fontSans: Theme.fontSans
    readonly property string fontMono: Theme.fontMono
    readonly property string iconUrl: "file://" + Quickshell.env("HOME") + "/.local/share/icons/hicolor/scalable/apps/mondlicht-settings.svg"

    property string activeTab: "appearance"
    readonly property var tabs: [
        { id: "appearance", icon: "󰏘", label: "Appearance" },
        { id: "display",    icon: "󰍹", label: "Display" },
        { id: "sound",      icon: "󰕾", label: "Sound" },
        { id: "power",      icon: "󰁹", label: "Power" },
        { id: "network",    icon: "󰖩", label: "Network" },
        { id: "input",      icon: "󰌌", label: "Input" },
        { id: "system",     icon: "󰒓", label: "System" }
    ]

    // Live Hyprland & hardware state
    property bool blurOn: true
    property bool shadowOn: true
    property bool glowOn: true
    property bool animOn: true
    property int roundingPx: 6
    property int gapsPx: 5

    property var monitorsList: []
    property bool hasBacklight: false
    property int brightPct: 80

    property bool naturalScroll: true
    property bool tapToClick: true
    property bool followMouse: true
    property real pointerSens: 0.0

    property bool wifiEnabled: true
    property string netSummary: "Checking..."
    property string netIp: ""
    property string netGateway: ""
    property string netDns: ""
    property var printersList: []
    property string hostName: ""
    property string kernelVer: ""
    property string hyprVer: ""
    property string cpuName: ""
    property string memTotal: ""
    property string diskInfo: ""
    property string uptimeStr: ""

    readonly property var btAdapter: Bluetooth.defaultAdapter
    readonly property bool btOn: btAdapter ? btAdapter.enabled : false
    readonly property var batDev: UPower.displayDevice
    readonly property bool hasBattery: batDev && batDev.ready && batDev.isLaptopBattery
    readonly property int batPct: hasBattery ? Math.round(batDev.percentage * 100) : -1
    readonly property bool batCharging: hasBattery && batDev.state === UPowerDeviceState.Charging

    PwObjectTracker {
        objects: Pipewire.nodes.values
    }

    readonly property var sink: Pipewire.defaultAudioSink
    readonly property var mic: Pipewire.defaultAudioSource

    function nodesWhere(pred) {
        const out = [];
        const list = Pipewire.nodes.values;
        for (let i = 0; i < list.length; i++) {
            const n = list[i];
            if (n && n.ready && n.audio && pred(n)) out.push(n);
        }
        return out;
    }

    function appStreams() {
        return nodesWhere(n => n.isSink && n.isStream);
    }

    function outputDevices() {
        return nodesWhere(n => n.isSink && !n.isStream);
    }

    function inputDevices() {
        return nodesWhere(n => !n.isSink && !n.isStream && !(n.name || "").endsWith(".monitor"));
    }

    function fmtDuration(secs) {
        if (!secs || secs <= 60) return "";
        const h = Math.floor(secs / 3600);
        const m = Math.round((secs % 3600) / 60);
        return h > 0 ? (h + "h " + m + "m") : (m + "m");
    }

    property bool savedBadge: false

    Timer {
        id: savedTimer
        interval: 1400
        onTriggered: win.savedBadge = false
    }

    Timer {
        id: saveDebounce
        interval: 220
        onTriggered: {
            Quickshell.execDetached([
                "python3", "-c",
                "import os,sys; p=os.path.expanduser('~/.config/hypr/user-prefs.lua'); os.makedirs(os.path.dirname(p),exist_ok=True); g,r,b,s,a,f,sn,ns,tc=sys.argv[1:10]; g=int(g); out=f'-- Auto-generated by Mondlicht Settings\nhl.config({{\n    general = {{ gaps_in = {g}, gaps_out = {g*2} }},\n    decoration = {{\n        rounding = {r},\n        blur = {{ enabled = {b} }},\n        shadow = {{ enabled = {s} }},\n        glow = {{ enabled = {s} }},\n    }},\n    animations = {{ enabled = {a} }},\n    input = {{\n        follow_mouse = {f},\n        sensitivity = {sn},\n        touchpad = {{ natural_scroll = {ns}, tap_to_click = {tc} }},\n    }},\n}})\n'; open(p,'w').write(out)",
                String(win.gapsPx),
                String(win.roundingPx),
                win.blurOn ? "true" : "false",
                win.shadowOn ? "true" : "false",
                win.animOn ? "true" : "false",
                win.followMouse ? "1" : "2",
                win.pointerSens.toFixed(2),
                win.naturalScroll ? "true" : "false",
                win.tapToClick ? "true" : "false"
            ]);
            win.savedBadge = true;
            savedTimer.restart();
        }
    }

    function hyprEval(luaCode) {
        Quickshell.execDetached(["hyprctl", "eval", luaCode]);
    }

    function saveUserPrefs() {
        saveDebounce.restart();
    }

    Process {
        id: stateProc
        command: [
            "python3", "-c",
            `import json, os, shutil, subprocess
def out(cmd):
try: return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL).strip()
except Exception: return ""
def jcmd(cmd):
try: return json.loads(out(cmd))
except Exception: return {}
data = {
"blur": jcmd(["hyprctl", "-j", "getoption", "decoration:blur:enabled"]).get("bool", True),
"shadow": jcmd(["hyprctl", "-j", "getoption", "decoration:shadow:enabled"]).get("bool", True),
"glow": jcmd(["hyprctl", "-j", "getoption", "decoration:glow:enabled"]).get("bool", True),
"anim": jcmd(["hyprctl", "-j", "getoption", "animations:enabled"]).get("bool", True),
"rounding": jcmd(["hyprctl", "-j", "getoption", "decoration:rounding"]).get("int", 6),
"gaps_in": jcmd(["hyprctl", "-j", "getoption", "general:gaps_in"]).get("css", "5").split()[0],
"nat_scroll": jcmd(["hyprctl", "-j", "getoption", "input:touchpad:natural_scroll"]).get("bool", True),
"tap": jcmd(["hyprctl", "-j", "getoption", "input:touchpad:tap_to_click"]).get("bool", True),
"follow": jcmd(["hyprctl", "-j", "getoption", "input:follow_mouse"]).get("int", 1) == 1,
"sens": jcmd(["hyprctl", "-j", "getoption", "input:sensitivity"]).get("float", 0.0),
"monitors": jcmd(["hyprctl", "-j", "monitors"]) if shutil.which("hyprctl") else [],
"night": bool(out(["pgrep", "-x", "hyprsunset"])),
"awake": not bool(out(["pgrep", "-x", "hypridle"])),
"bright": out(["sh", "-c", "brightnessctl -m 2>/dev/null | awk -F, '{gsub(/%/,\\\"\\\",$4); print $4}'"]),
"wifi_en": out(["nmcli", "radio", "wifi"]) == "enabled",
"net_active": out(["sh", "-c", "nmcli -t -f NAME,TYPE,DEVICE connection show --active 2>/dev/null | head -n1"]),
"net_ip": out(["sh", "-c", "ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++){if($i==\"src\") src=$(i+1); if($i==\"via\") gw=$(i+1)}} END{print src \"|\" gw}'"]),
"dns": out(["sh", "-c", "awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null"]),
"printers": out(["lpstat", "-p"]).splitlines(),
"host": out(["hostname"]),
"kernel": out(["uname", "-r"]),
"hypr": out(["sh", "-c", "hyprctl version -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get(\"tag\",\"Hyprland\"))'"]),
"cpu": out(["sh", "-c", "awk -F: '/model name/{gsub(/^ +/,\"\",$2); print $2; exit}' /proc/cpuinfo"]),
"mem": out(["sh", "-c", "free -h | awk '/Mem:/{print $3 \" / \" $2}'"]),
"disk": out(["sh", "-c", "df -h / | awk 'NR==2{print $3 \" / \" $2 \" (\" $5 \")\"}'"]),
"uptime": out(["sh", "-c", "uptime -p | sed 's/^up //'" ]),
}
print(json.dumps(data))`
        ]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const d = JSON.parse(text);
                    win.blurOn = !!d.blur;
                    win.shadowOn = !!d.shadow;
                    win.glowOn = !!d.glow;
                    win.animOn = !!d.anim;
                    win.roundingPx = parseInt(d.rounding, 10) || 0;
                    win.gapsPx = parseInt(d.gaps_in, 10) || 0;
                    win.naturalScroll = !!d.nat_scroll;
                    win.tapToClick = !!d.tap;
                    win.followMouse = !!d.follow;
                    win.pointerSens = Number(d.sens) || 0;
                    win.monitorsList = Array.isArray(d.monitors) ? d.monitors : [];
                    win.shell.nightLightOn = !!d.night;
                    win.shell.keepAwakeOn = !!d.awake;
                    const b = parseInt(d.bright, 10);
                    win.hasBacklight = !isNaN(b);
                    if (!isNaN(b)) win.brightPct = b;
                    win.wifiEnabled = !!d.wifi_en;
                    win.netSummary = d.net_active ? d.net_active.replace(/:/g, " · ") : "Disconnected";
                    const ipParts = (d.net_ip || "").split("|");
                    win.netIp = ipParts[0] || "-";
                    win.netGateway = ipParts[1] || "-";
                    win.netDns = d.dns || "-";
                    win.printersList = Array.isArray(d.printers) ? d.printers : [];
                    win.hostName = d.host || "-";
                    win.kernelVer = d.kernel || "-";
                    win.hyprVer = d.hypr || "Hyprland";
                    win.cpuName = d.cpu || "-";
                    win.memTotal = d.mem || "-";
                    win.diskInfo = d.disk || "-";
                    win.uptimeStr = d.uptime || "-";
                } catch (e) {}
            }
        }
    }

    Component.onCompleted: stateProc.running = true

    // Reusable inline components with consistent vertical/horizontal alignment
    component SectionCard: Rectangle {
        default property alias cardContent: innerCol.data
        Layout.fillWidth: true
        implicitHeight: innerCol.implicitHeight + 28
        radius: 12
        color: win.colCard
        border.width: 1
        border.color: win.colRim

        ColumnLayout {
            id: innerCol
            anchors { left: parent.left; right: parent.right; top: parent.top; margins: 14 }
            spacing: 11
        }
    }

    component SectionHeading: Text {
        Layout.fillWidth: true
        color: win.colAccent
        font.family: win.fontSans
        font.pixelSize: 11
        font.weight: Font.DemiBold
    }

    component ToggleRow: RowLayout {
        id: toggleRoot
        property string title: ""
        property string subtitle: ""
        property bool checked: false
        signal toggled(bool nextVal)
        Layout.fillWidth: true
        spacing: 12

        ColumnLayout {
            Layout.fillWidth: true
            Layout.alignment: Qt.AlignVCenter
            spacing: 2
            Text {
                text: toggleRoot.title
                color: win.colText
                font.family: win.fontSans
                font.pixelSize: 12
                font.weight: Font.Medium
                elide: Text.ElideRight
                Layout.fillWidth: true
            }
            Text {
                visible: toggleRoot.subtitle.length > 0
                text: toggleRoot.subtitle
                color: win.colMuted
                font.family: win.fontSans
                font.pixelSize: 10
                elide: Text.ElideRight
                Layout.fillWidth: true
            }
        }

        Rectangle {
            Layout.preferredWidth: 40
            Layout.preferredHeight: 22
            Layout.alignment: Qt.AlignVCenter
            radius: 11
            color: toggleRoot.checked ? win.colAccent : "#1d2334"
            border.width: 1
            border.color: toggleRoot.checked ? win.colAccent : win.colRim
            Behavior on color { ColorAnimation { duration: 150 } }

            Rectangle {
                x: toggleRoot.checked ? 20 : 3
                anchors.verticalCenter: parent.verticalCenter
                width: 16; height: 16; radius: 8
                color: toggleRoot.checked ? win.colAccentFg : win.colText
                Behavior on x { NumberAnimation { duration: 180; easing.type: Easing.OutExpo } }
            }

            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: toggleRoot.toggled(!toggleRoot.checked)
            }
        }
    }

    component SliderRow: RowLayout {
        id: sliderRoot
        property string icon: ""
        property string label: ""
        property string valueText: ""
        property real minVal: 0
        property real maxVal: 100
        property real value: 50
        signal moved(real val)
        Layout.fillWidth: true
        spacing: 10

        Text {
            visible: sliderRoot.icon.length > 0
            text: sliderRoot.icon
            color: win.colText
            font.family: win.fontMono
            font.pixelSize: 16
            horizontalAlignment: Text.AlignHCenter
            Layout.preferredWidth: 18
            Layout.alignment: Qt.AlignVCenter
        }
        Text {
            visible: sliderRoot.label.length > 0
            text: sliderRoot.label
            color: win.colText
            font.family: win.fontSans
            font.pixelSize: 12
            // Keep slider tracks horizontally aligned whether icon is shown or omitted
            Layout.preferredWidth: sliderRoot.icon.length > 0 ? 116 : 144
            Layout.alignment: Qt.AlignVCenter
            elide: Text.ElideRight
        }
        Item {
            Layout.fillWidth: true
            Layout.preferredHeight: 20
            Layout.alignment: Qt.AlignVCenter
            readonly property real ratio: Math.max(0, Math.min(1, (sliderRoot.value - sliderRoot.minVal) / Math.max(0.0001, sliderRoot.maxVal - sliderRoot.minVal)))
            Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: parent.width; height: 5; radius: 3
                color: "#1c2233"
                Rectangle {
                    width: Math.max(6, parent.width * parent.parent.ratio)
                    height: parent.height; radius: 3
                    color: win.colAccent
                }
            }
            Rectangle {
                x: Math.max(0, Math.min(parent.width - width, parent.width * parent.ratio - width / 2))
                anchors.verticalCenter: parent.verticalCenter
                width: 14; height: 14; radius: 7
                color: win.colText
                border.width: 2; border.color: win.colAccent
            }
            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                function emitRatio(mx) {
                    const r = Math.max(0, Math.min(1, mx / Math.max(1, width)));
                    sliderRoot.moved(sliderRoot.minVal + r * (sliderRoot.maxVal - sliderRoot.minVal));
                }
                onPressed: function(m) { emitRatio(m.x); }
                onPositionChanged: function(m) { if (pressed) emitRatio(m.x); }
            }
        }
        Text {
            text: sliderRoot.valueText
            color: win.colMuted
            font.family: win.fontMono
            font.pixelSize: 11
            Layout.preferredWidth: 48
            Layout.alignment: Qt.AlignVCenter
            horizontalAlignment: Text.AlignRight
        }
    }

    component InfoRow: RowLayout {
        id: infoRoot
        property string k: ""
        property string v: ""
        Layout.fillWidth: true
        spacing: 12
        Text {
            text: infoRoot.k
            color: win.colMuted
            font.family: win.fontSans
            font.pixelSize: 11
            Layout.preferredWidth: 144
            Layout.alignment: Qt.AlignVCenter
        }
        Text {
            text: infoRoot.v
            color: win.colText
            font.family: win.fontSans
            font.pixelSize: 11
            font.weight: Font.Medium
            horizontalAlignment: Text.AlignRight
            elide: Text.ElideRight
            Layout.fillWidth: true
            Layout.alignment: Qt.AlignVCenter
        }
    }

    Rectangle {
        id: shellFrame
        anchors.fill: parent
        radius: 14
        color: win.colVoid
        border.width: 1
        border.color: win.colRim
        focus: true

        Keys.onEscapePressed: win.shell.settingsOpen = false

        RowLayout {
            anchors.fill: parent
            spacing: 0

            // Left Navigation Rail
            Rectangle {
                Layout.preferredWidth: 210
                Layout.fillHeight: true
                radius: 14
                color: win.colSidebar

                Rectangle {
                    anchors { top: parent.top; bottom: parent.bottom; right: parent.right }
                    width: 14
                    color: parent.color
                }
                Rectangle {
                    anchors { top: parent.top; bottom: parent.bottom; right: parent.right }
                    width: 1
                    color: win.colRim
                }

                ColumnLayout {
                    anchors { fill: parent; margins: 14 }
                    spacing: 5

                    RowLayout {
                        Layout.fillWidth: true
                        Layout.bottomMargin: 10
                        spacing: 10
                        Image {
                            Layout.preferredWidth: 32
                            Layout.preferredHeight: 32
                            Layout.alignment: Qt.AlignVCenter
                            sourceSize: Qt.size(64, 64)
                            smooth: true
                            source: win.iconUrl
                        }
                        ColumnLayout {
                            Layout.fillWidth: true
                            Layout.alignment: Qt.AlignVCenter
                            spacing: 0
                            Text { text: "Mondlicht"; color: win.colText; font.family: win.fontSans; font.pixelSize: 14; font.weight: Font.Bold }
                            Text { text: "Settings"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 10 }
                        }
                    }

                    Repeater {
                        model: win.tabs
                        Rectangle {
                            required property var modelData
                            readonly property bool selected: win.activeTab === modelData.id
                            Layout.fillWidth: true
                            Layout.preferredHeight: 36
                            radius: 9
                            color: selected ? win.colAccent : (tabHov.hovered ? win.colElevated : "transparent")
                            Behavior on color { ColorAnimation { duration: 140 } }

                            RowLayout {
                                anchors { fill: parent; leftMargin: 12; rightMargin: 12 }
                                spacing: 10
                                Text {
                                    text: modelData.icon
                                    color: selected ? win.colAccentFg : win.colMuted
                                    font.family: win.fontMono
                                    font.pixelSize: 15
                                    horizontalAlignment: Text.AlignHCenter
                                    Layout.preferredWidth: 20
                                    Layout.alignment: Qt.AlignVCenter
                                }
                                Text {
                                    text: modelData.label
                                    color: selected ? win.colAccentFg : win.colText
                                    font.family: win.fontSans
                                    font.pixelSize: 12
                                    font.weight: selected ? Font.DemiBold : Font.Medium
                                    Layout.fillWidth: true
                                    Layout.alignment: Qt.AlignVCenter
                                }
                            }

                            HoverHandler { id: tabHov; cursorShape: Qt.PointingHandCursor }
                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    win.activeTab = modelData.id;
                                    stateProc.running = true;
                                }
                            }
                        }
                    }

                    Item { Layout.fillHeight: true }

                    Rectangle {
                        Layout.fillWidth: true
                        Layout.preferredHeight: 34
                        radius: 8
                        color: refHov.hovered ? win.colElevated : win.colCard
                        border.width: 1; border.color: win.colRim
                        RowLayout {
                            anchors.centerIn: parent
                            spacing: 7
                            Text { text: "󰑓"; color: win.colMuted; font.family: win.fontMono; font.pixelSize: 13; Layout.alignment: Qt.AlignVCenter }
                            Text { text: "Refresh Status"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 11; Layout.alignment: Qt.AlignVCenter }
                        }
                        HoverHandler { id: refHov; cursorShape: Qt.PointingHandCursor }
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: stateProc.running = true
                        }
                    }
                }
            }

            // Right Content Area
            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                contentWidth: width
                contentHeight: pageCol.implicitHeight + 40
                clip: true

                ColumnLayout {
                    id: pageCol
                    anchors { left: parent.left; right: parent.right; top: parent.top; margins: 20 }
                    spacing: 14

                    // Page Title Bar
                    RowLayout {
                        Layout.fillWidth: true
                        Text {
                            text: {
                                for (let i = 0; i < win.tabs.length; i++) {
                                    if (win.tabs[i].id === win.activeTab) return win.tabs[i].label;
                                }
                                return "Settings";
                            }
                            color: win.colText
                            font.family: win.fontSans
                            font.pixelSize: 19
                            font.weight: Font.Bold
                            Layout.fillWidth: true
                            Layout.alignment: Qt.AlignVCenter
                        }
                        Rectangle {
                            visible: win.savedBadge
                            radius: 6
                            color: "#2286c5a9"
                            border.width: 1; border.color: win.colOk
                            implicitWidth: savedLbl.implicitWidth + 14
                            implicitHeight: 22
                            Layout.alignment: Qt.AlignVCenter
                            Text {
                                id: savedLbl
                                anchors.centerIn: parent
                                text: "✓ Saved"
                                color: win.colOk
                                font.family: win.fontSans
                                font.pixelSize: 10
                                font.weight: Font.DemiBold
                            }
                        }
                        Text {
                            text: "Esc to close"
                            color: win.colMuted
                            font.family: win.fontMono
                            font.pixelSize: 10
                            Layout.alignment: Qt.AlignVCenter
                        }
                    }

                    // 1. APPEARANCE
                    ColumnLayout {
                        visible: win.activeTab === "appearance"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 12
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    Layout.alignment: Qt.AlignVCenter
                                    spacing: 2
                                    Text { text: "Wallpaper & Dynamic Accents"; color: win.colText; font.family: win.fontSans; font.pixelSize: 13; font.weight: Font.DemiBold; Layout.fillWidth: true }
                                    Text { text: "matugen v4 updates Hyprland, Quickshell, Kitty, Fuzzel & GTK live"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                                }
                                Rectangle {
                                    Layout.preferredWidth: 138
                                    Layout.preferredHeight: 34
                                    Layout.alignment: Qt.AlignVCenter
                                    radius: 8
                                    color: wpBtnHov.hovered ? win.colAccent : win.colElevated
                                    border.width: 1; border.color: win.colAccent
                                    RowLayout {
                                        anchors.centerIn: parent
                                        spacing: 6
                                        Text { text: "󰸉"; color: wpBtnHov.hovered ? win.colAccentFg : win.colAccent; font.family: win.fontMono; font.pixelSize: 14 }
                                        Text { text: "Pick Wallpaper"; color: wpBtnHov.hovered ? win.colAccentFg : win.colText; font.family: win.fontSans; font.pixelSize: 11; font.weight: Font.DemiBold }
                                    }
                                    HoverHandler { id: wpBtnHov; cursorShape: Qt.PointingHandCursor }
                                    MouseArea {
                                        anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                        onClicked: Quickshell.execDetached(["qs", "-c", "mondlicht", "ipc", "call", "shell", "toggleWallpaper"])
                                    }
                                }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "Compositor Effects (Live)" }
                            ToggleRow {
                                title: "Night Light (4200K)"
                                subtitle: "Warm blue-light filter via hyprsunset"
                                checked: win.shell.nightLightOn
                                onToggled: {
                                    win.shell.nightLightOn = !win.shell.nightLightOn;
                                    Quickshell.execDetached([Quickshell.env("HOME") + "/.local/bin/night-light"]);
                                }
                            }
                            ToggleRow {
                                title: "Frosted Glass Blur"
                                subtitle: "Turn off blur to save battery on iGPU"
                                checked: win.blurOn
                                onToggled: function(v) { win.blurOn = v; win.hyprEval("hl.config({ decoration = { blur = { enabled = " + v + " } } })"); win.saveUserPrefs(); }
                            }
                            ToggleRow {
                                title: "Window Shadows & Lunar Glow"
                                subtitle: "Drop shadows and subtle active border glow"
                                checked: win.shadowOn
                                onToggled: function(v) {
                                    win.shadowOn = v; win.glowOn = v;
                                    win.hyprEval("hl.config({ decoration = { shadow = { enabled = " + v + " }, glow = { enabled = " + v + " } } })"); win.saveUserPrefs();
                                }
                            }
                            ToggleRow {
                                title: "Window Animations"
                                subtitle: "Smooth bezier slide and popin transitions"
                                checked: win.animOn
                                onToggled: function(v) { win.animOn = v; win.hyprEval("hl.config({ animations = { enabled = " + v + " } })"); win.saveUserPrefs(); }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "Geometry (Live Session)" }
                            SliderRow {
                                label: "Corner Rounding"
                                minVal: 0; maxVal: 18; value: win.roundingPx
                                valueText: win.roundingPx + " px"
                                onMoved: function(v) {
                                    win.roundingPx = Math.round(v);
                                    win.hyprEval("hl.config({ decoration = { rounding = " + win.roundingPx + " } })"); win.saveUserPrefs();
                                }
                            }
                            SliderRow {
                                label: "Inner Window Gaps"
                                minVal: 0; maxVal: 16; value: win.gapsPx
                                valueText: win.gapsPx + " px"
                                onMoved: function(v) {
                                    win.gapsPx = Math.round(v);
                                    win.hyprEval("hl.config({ general = { gaps_in = " + win.gapsPx + ", gaps_out = " + (win.gapsPx * 2) + " } })"); win.saveUserPrefs();
                                }
                            }
                        }
                    }

                    // 2. DISPLAY
                    ColumnLayout {
                        visible: win.activeTab === "display"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            visible: win.hasBacklight
                            SectionHeading { text: "Backlight Brightness" }
                            SliderRow {
                                icon: "󰃟"
                                label: "Panel Brightness"
                                minVal: 5; maxVal: 100; value: win.brightPct
                                valueText: win.brightPct + "%"
                                onMoved: function(v) {
                                    win.brightPct = Math.round(v);
                                    Quickshell.execDetached(["brightnessctl", "set", win.brightPct + "%"]);
                                }
                            }
                        }

                        Repeater {
                            model: win.monitorsList
                            SectionCard {
                                required property var modelData
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 2
                                    Text { text: modelData.name + "  ·  " + (modelData.description || "Display"); color: win.colText; font.family: win.fontSans; font.pixelSize: 13; font.weight: Font.DemiBold; elide: Text.ElideRight; Layout.fillWidth: true }
                                    Text { text: modelData.width + "x" + modelData.height + " @ " + Math.round(modelData.refreshRate) + " Hz  ·  Scale " + modelData.scale + "x"; color: win.colMuted; font.family: win.fontMono; font.pixelSize: 11; Layout.fillWidth: true }
                                }
                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 8
                                    Text { text: "Scale:"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 11; Layout.alignment: Qt.AlignVCenter }
                                    Repeater {
                                        model: [1.0, 1.25, 1.5, 1.75, 2.0]
                                        Rectangle {
                                            required property real modelData
                                            readonly property var monObj: parent.parent.modelData
                                            readonly property bool cur: Math.abs(monObj.scale - modelData) < 0.05
                                            Layout.preferredWidth: 50
                                            Layout.preferredHeight: 28
                                            Layout.alignment: Qt.AlignVCenter
                                            radius: 7
                                            color: cur ? win.colAccent : (scHov.hovered ? win.colElevated : "#151926")
                                            border.width: 1; border.color: cur ? win.colAccent : win.colRim
                                            Text { anchors.centerIn: parent; text: modelData + "x"; color: cur ? win.colAccentFg : win.colText; font.family: win.fontMono; font.pixelSize: 11 }
                                            HoverHandler { id: scHov; cursorShape: Qt.PointingHandCursor }
                                            MouseArea {
                                                anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                                onClicked: {
                                                    win.hyprEval("hl.monitor({ output = '" + monObj.name + "', mode = '" + monObj.width + "x" + monObj.height + "@" + Math.round(monObj.refreshRate) + "', position = 'auto', scale = " + modelData + " })");
                                                    delayRefresh.restart();
                                                }
                                            }
                                        }
                                    }
                                    Item { Layout.fillWidth: true }
                                }
                            }
                        }
                    }

                    // 3. SOUND
                    ColumnLayout {
                        visible: win.activeTab === "sound"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            SectionHeading { text: "Output & Input Levels" }
                            SliderRow {
                                icon: (win.sink && win.sink.audio && win.sink.audio.muted) ? "󰖁" : "󰕾"
                                label: "Master Output"
                                minVal: 0; maxVal: 100
                                value: (win.sink && win.sink.audio) ? Math.round(win.sink.audio.volume * 100) : 0
                                valueText: (win.sink && win.sink.audio && win.sink.audio.muted) ? "Mute" : (((win.sink && win.sink.audio) ? Math.round(win.sink.audio.volume * 100) : 0) + "%")
                                onMoved: function(v) { Quickshell.execDetached(["wpctl", "set-volume", "-l", "1", "@DEFAULT_AUDIO_SINK@", Math.round(v) + "%"]); }
                            }
                            SliderRow {
                                visible: win.mic !== null
                                icon: (win.mic && win.mic.audio && win.mic.audio.muted) ? "󰍭" : "󰍬"
                                label: "Microphone"
                                minVal: 0; maxVal: 100
                                value: (win.mic && win.mic.audio) ? Math.round(win.mic.audio.volume * 100) : 0
                                valueText: (win.mic && win.mic.audio && win.mic.audio.muted) ? "Mute" : (((win.mic && win.mic.audio) ? Math.round(win.mic.audio.volume * 100) : 0) + "%")
                                onMoved: function(v) { Quickshell.execDetached(["wpctl", "set-volume", "-l", "1", "@DEFAULT_AUDIO_SOURCE@", Math.round(v) + "%"]); }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "Output Device" }
                            Repeater {
                                model: win.outputDevices()
                                Rectangle {
                                    required property var modelData
                                    readonly property bool active: win.sink && win.sink.id === modelData.id
                                    Layout.fillWidth: true; Layout.preferredHeight: 36; radius: 8
                                    color: active ? "#26adc6ff" : (oDevHov.hovered ? win.colElevated : "#121520")
                                    border.width: 1; border.color: active ? win.colAccent : win.colRim
                                    RowLayout {
                                        anchors { fill: parent; leftMargin: 12; rightMargin: 12 }
                                        spacing: 10
                                        Text { text: active ? "󰄬" : "󰕾"; color: active ? win.colAccent : win.colMuted; font.family: win.fontMono; font.pixelSize: 14; horizontalAlignment: Text.AlignHCenter; Layout.preferredWidth: 18; Layout.alignment: Qt.AlignVCenter }
                                        Text { text: modelData.description || modelData.nickname || modelData.name; color: win.colText; font.family: win.fontSans; font.pixelSize: 12; elide: Text.ElideRight; Layout.fillWidth: true; Layout.alignment: Qt.AlignVCenter }
                                    }
                                    HoverHandler { id: oDevHov; cursorShape: Qt.PointingHandCursor }
                                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: Quickshell.execDetached(["wpctl", "set-default", String(modelData.id)]) }
                                }
                            }
                        }

                        SectionCard {
                            visible: win.inputDevices().length > 0
                            SectionHeading { text: "Input Device (Microphone)" }
                            Repeater {
                                model: win.inputDevices()
                                Rectangle {
                                    required property var modelData
                                    readonly property bool active: win.mic && win.mic.id === modelData.id
                                    Layout.fillWidth: true; Layout.preferredHeight: 36; radius: 8
                                    color: active ? "#26adc6ff" : (iDevHov.hovered ? win.colElevated : "#121520")
                                    border.width: 1; border.color: active ? win.colAccent : win.colRim
                                    RowLayout {
                                        anchors { fill: parent; leftMargin: 12; rightMargin: 12 }
                                        spacing: 10
                                        Text { text: active ? "󰄬" : "󰍬"; color: active ? win.colAccent : win.colMuted; font.family: win.fontMono; font.pixelSize: 14; horizontalAlignment: Text.AlignHCenter; Layout.preferredWidth: 18; Layout.alignment: Qt.AlignVCenter }
                                        Text { text: modelData.description || modelData.nickname || modelData.name; color: win.colText; font.family: win.fontSans; font.pixelSize: 12; elide: Text.ElideRight; Layout.fillWidth: true; Layout.alignment: Qt.AlignVCenter }
                                    }
                                    HoverHandler { id: iDevHov; cursorShape: Qt.PointingHandCursor }
                                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: Quickshell.execDetached(["wpctl", "set-default", String(modelData.id)]) }
                                }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "Per-App Volume Mixer" }
                            Text { visible: win.appStreams().length === 0; text: "No active audio playback streams right now"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 11; Layout.fillWidth: true }
                            Repeater {
                                model: win.appStreams()
                                SliderRow {
                                    required property var modelData
                                    icon: (modelData.audio && modelData.audio.muted) ? "󰖁" : "󰝚"
                                    label: (modelData.properties && (modelData.properties["application.name"] || modelData.properties["node.name"])) || modelData.nickname || modelData.name || "App"
                                    minVal: 0; maxVal: 100
                                    value: modelData.audio ? Math.round(modelData.audio.volume * 100) : 100
                                    valueText: (modelData.audio && modelData.audio.muted) ? "Mute" : ((modelData.audio ? Math.round(modelData.audio.volume * 100) : 100) + "%")
                                    onMoved: function(v) { Quickshell.execDetached(["wpctl", "set-volume", "-l", "1", String(modelData.id), Math.round(v) + "%"]); }
                                }
                            }
                        }
                    }

                    // 4. POWER
                    ColumnLayout {
                        visible: win.activeTab === "power"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            visible: win.hasBattery
                            SectionHeading { text: "Battery Telemetry" }
                            InfoRow { k: "Charge"; v: win.batPct + "%" + (win.batCharging ? " (Charging)" : " (Discharging)") }
                            InfoRow {
                                k: win.batCharging ? "Time to Full" : "Remaining"
                                v: win.fmtDuration(win.batCharging ? (win.batDev ? win.batDev.timeToFull : 0) : (win.batDev ? win.batDev.timeToEmpty : 0)) || "Calculating..."
                            }
                            InfoRow { k: "Power Draw"; v: (win.batDev && win.batDev.changeRate ? Math.abs(win.batDev.changeRate).toFixed(2) + " W" : "-") }
                            InfoRow { k: "Battery Health"; v: (win.batDev && win.batDev.healthPercentage > 0 ? win.batDev.healthPercentage.toFixed(1) + "%" : "-") }
                        }

                        SectionCard {
                            SectionHeading { text: "Performance Profile (tuned-ppd)" }
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 8
                                Repeater {
                                    model: {
                                        const l = [
                                            { profile: PowerProfile.PowerSaver, label: "Power Saver", icon: "󰌪" },
                                            { profile: PowerProfile.Balanced, label: "Balanced", icon: "󰾅" }
                                        ];
                                        if (PowerProfiles.hasPerformanceProfile) l.push({ profile: PowerProfile.Performance, label: "Performance", icon: "󰓅" });
                                        return l;
                                    }
                                    Rectangle {
                                        required property var modelData
                                        readonly property bool active: PowerProfiles.profile === modelData.profile
                                        Layout.fillWidth: true; Layout.preferredHeight: 38; radius: 8
                                        color: active ? win.colAccent : (ppHov.hovered ? win.colElevated : "#121520")
                                        border.width: 1; border.color: active ? win.colAccent : win.colRim
                                        RowLayout {
                                            anchors.centerIn: parent; spacing: 6
                                            Text { text: modelData.icon; color: active ? win.colAccentFg : win.colMuted; font.family: win.fontMono; font.pixelSize: 14; Layout.alignment: Qt.AlignVCenter }
                                            Text { text: modelData.label; color: active ? win.colAccentFg : win.colText; font.family: win.fontSans; font.pixelSize: 12; font.weight: Font.DemiBold; Layout.alignment: Qt.AlignVCenter }
                                        }
                                        HoverHandler { id: ppHov; cursorShape: Qt.PointingHandCursor }
                                        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: PowerProfiles.profile = modelData.profile }
                                    }
                                }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "Idle & Power Saving" }
                            ToggleRow {
                                title: "Keep Awake (Pause hypridle)"
                                subtitle: "Prevent idle screen dim, auto-lock, and suspend"
                                checked: win.shell.keepAwakeOn
                                onToggled: function(v) {
                                    win.shell.keepAwakeOn = v;
                                    Quickshell.execDetached([
                                        "sh", "-c",
                                        v
                                            ? "systemctl --user stop hypridle.service >/dev/null 2>&1 || pkill -x hypridle >/dev/null 2>&1 || true"
                                            : "systemctl --user start hypridle.service >/dev/null 2>&1 || pgrep -x hypridle >/dev/null 2>&1 || setsid -f hypridle </dev/null >/dev/null 2>&1"
                                    ]);
                                }
                            }
                            ToggleRow {
                                title: "Eco Visuals"
                                subtitle: "Disable blur, shadows & glow for lower iGPU power draw"
                                checked: !win.blurOn && !win.shadowOn
                                onToggled: function(v) {
                                    win.blurOn = !v; win.shadowOn = !v; win.glowOn = !v;
                                    win.hyprEval("hl.config({ decoration = { blur = { enabled = " + (!v) + " }, shadow = { enabled = " + (!v) + " }, glow = { enabled = " + (!v) + " } } })");
                                }
                            }
                        }
                    }

                    // 5. NETWORK
                    ColumnLayout {
                        visible: win.activeTab === "network"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            SectionHeading { text: "Network Connection" }
                            InfoRow { k: "Active Link"; v: win.netSummary }
                            InfoRow { k: "IPv4 Address"; v: win.netIp }
                            InfoRow { k: "Gateway"; v: win.netGateway }
                            InfoRow { k: "DNS"; v: win.netDns }
                            ToggleRow {
                                title: "Wi-Fi Radio"
                                subtitle: "Toggle wireless networking hardware"
                                checked: win.wifiEnabled
                                onToggled: function(v) {
                                    win.wifiEnabled = v;
                                    Quickshell.execDetached(["nmcli", "radio", "wifi", v ? "on" : "off"]);
                                    delayRefresh.restart();
                                }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "Bluetooth" }
                            ToggleRow {
                                title: "Bluetooth Adapter"
                                subtitle: win.btAdapter ? (win.btOn ? "Powered On" : "Powered Off") : "No Bluetooth adapter found"
                                checked: win.btOn
                                onToggled: function(v) { if (win.btAdapter) win.btAdapter.enabled = v; }
                            }
                            Rectangle {
                                Layout.fillWidth: true; Layout.preferredHeight: 34; radius: 8
                                color: qsNetHov.hovered ? win.colAccent : win.colElevated
                                border.width: 1; border.color: win.colRim
                                Text {
                                    anchors.centerIn: parent
                                    text: "Open Inline Wi-Fi / Bluetooth Selector in Quick Settings"
                                    color: qsNetHov.hovered ? win.colAccentFg : win.colText
                                    font.family: win.fontSans; font.pixelSize: 11; font.weight: Font.Medium
                                }
                                HoverHandler { id: qsNetHov; cursorShape: Qt.PointingHandCursor }
                                MouseArea {
                                    anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                    onClicked: Quickshell.execDetached(["qs", "-c", "mondlicht", "ipc", "call", "shell", "toggleQuickSettings"])
                                }
                            }
                        }
                    }

                    // 6. INPUT
                    ColumnLayout {
                        visible: win.activeTab === "input"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            SectionHeading { text: "Touchpad & Mouse (Live)" }
                            ToggleRow {
                                title: "Natural Scrolling"
                                subtitle: "Reverse vertical scroll direction like macOS"
                                checked: win.naturalScroll
                                onToggled: function(v) { win.naturalScroll = v; win.hyprEval("hl.config({ input = { touchpad = { natural_scroll = " + v + " } } })"); win.saveUserPrefs(); }
                            }
                            ToggleRow {
                                title: "Tap to Click"
                                subtitle: "Single-finger touchpad tap acts as left click"
                                checked: win.tapToClick
                                onToggled: function(v) { win.tapToClick = v; win.hyprEval("hl.config({ input = { touchpad = { tap_to_click = " + v + " } } })"); win.saveUserPrefs(); }
                            }
                            ToggleRow {
                                title: "Focus Follows Mouse"
                                subtitle: "Hovering a window focuses it automatically"
                                checked: win.followMouse
                                onToggled: function(v) { win.followMouse = v; win.hyprEval("hl.config({ input = { follow_mouse = " + (v ? 1 : 2) + " } })"); win.saveUserPrefs(); }
                            }
                            SliderRow {
                                label: "Pointer Sensitivity"
                                minVal: -0.8; maxVal: 0.8; value: win.pointerSens
                                valueText: win.pointerSens.toFixed(2)
                                onMoved: function(v) {
                                    win.pointerSens = Math.round(v * 20) / 20;
                                    win.hyprEval("hl.config({ input = { sensitivity = " + win.pointerSens.toFixed(2) + " } })"); win.saveUserPrefs();
                                }
                            }
                        }

                        SectionCard {
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 12
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    Layout.alignment: Qt.AlignVCenter
                                    spacing: 2
                                    Text { text: "Keyboard Shortcuts & Packages"; color: win.colText; font.family: win.fontSans; font.pixelSize: 12; font.weight: Font.DemiBold; Layout.fillWidth: true }
                                    Text { text: "Open the Cmd+/ quick reference modal"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 10; Layout.fillWidth: true }
                                }
                                Rectangle {
                                    Layout.preferredWidth: 118
                                    Layout.preferredHeight: 32
                                    Layout.alignment: Qt.AlignVCenter
                                    radius: 8
                                    color: kbdHov.hovered ? win.colAccent : win.colElevated
                                    border.width: 1; border.color: win.colRim
                                    Text { anchors.centerIn: parent; text: "Open Guide"; color: kbdHov.hovered ? win.colAccentFg : win.colText; font.family: win.fontSans; font.pixelSize: 11; font.weight: Font.DemiBold }
                                    HoverHandler { id: kbdHov; cursorShape: Qt.PointingHandCursor }
                                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.shell.openOnly("guide") }
                                }
                            }
                        }
                    }

                    // 7. SYSTEM
                    ColumnLayout {
                        visible: win.activeTab === "system"
                        Layout.fillWidth: true
                        spacing: 12

                        SectionCard {
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 12
                                SectionHeading { text: "CUPS Printers"; Layout.alignment: Qt.AlignVCenter }
                                Rectangle {
                                    Layout.preferredWidth: 146
                                    Layout.preferredHeight: 30
                                    Layout.alignment: Qt.AlignVCenter
                                    radius: 7
                                    color: prnHov.hovered ? win.colAccent : win.colElevated
                                    border.width: 1; border.color: win.colRim
                                    RowLayout {
                                        anchors.centerIn: parent
                                        spacing: 6
                                        Text { text: "󰐪"; color: prnHov.hovered ? win.colAccentFg : win.colAccent; font.family: win.fontMono; font.pixelSize: 13 }
                                        Text { text: "Manage Printers"; color: prnHov.hovered ? win.colAccentFg : win.colText; font.family: win.fontSans; font.pixelSize: 11; font.weight: Font.DemiBold }
                                    }
                                    HoverHandler { id: prnHov; cursorShape: Qt.PointingHandCursor }
                                    MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: Quickshell.execDetached(["system-config-printer"]) }
                                }
                            }
                            Text { visible: win.printersList.length === 0; text: "No CUPS printers configured yet"; color: win.colMuted; font.family: win.fontSans; font.pixelSize: 11; Layout.fillWidth: true }
                            Repeater {
                                model: win.printersList
                                Text { required property string modelData; text: modelData; color: win.colText; font.family: win.fontMono; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                            }
                        }

                        SectionCard {
                            SectionHeading { text: "About This System" }
                            InfoRow { k: "Desktop"; v: "Mondlicht (Hyprland + Quickshell)" }
                            InfoRow { k: "Hostname"; v: win.hostName }
                            InfoRow { k: "OS / Kernel"; v: "Arch Linux · " + win.kernelVer }
                            InfoRow { k: "Compositor"; v: win.hyprVer }
                            InfoRow { k: "CPU"; v: win.cpuName }
                            InfoRow { k: "Memory"; v: win.memTotal }
                            InfoRow { k: "Root Disk"; v: win.diskInfo }
                            InfoRow { k: "Uptime"; v: win.uptimeStr }
                        }
                    }
                }
            }
        }
    }

    Timer {
        id: delayRefresh
        interval: 600
        onTriggered: stateProc.running = true
    }
}
